{
  "name": "soybean-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:app": "vite --mode test",
    "build": "vite build --mode prod",
    "format": "oxfmt --check src scripts vite.config.ts uno.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json .vscode/extensions.json .vscode/settings.json",
    "format:write": "oxfmt --write src scripts vite.config.ts uno.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json .vscode/extensions.json .vscode/settings.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src scripts vite.config.ts uno.config.ts",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives src scripts vite.config.ts uno.config.ts",
    "mock": "bun scripts/mock-service.ts",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "quality": "bun run typecheck && bun run lint && bun run format && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run quality"
  }
}
